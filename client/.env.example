# Geoapify browser key for map tiles, address autocomplete and reverse geocoding.
# Create at https://myprojects.geoapify.com/ (Free plan, no card required).
# This key is public: restrict it to your frontend origins / HTTP referrers.
# Use a separate IP-restricted key for GEOAPIFY_API_KEY in server/.env.
VITE_GEOAPIFY_API_KEY=

# Optional Google Maps tracking view. Enable Maps JavaScript API and restrict this key to frontend origins.
# Geoapify remains the routing and address service and the fallback map.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Dev only: where `npm run dev` proxies /api and /uploads. Defaults to the Node API
# (http://localhost:5000); use http://localhost:8787 for `npm run dev:worker` in server/.
API_PROXY_TARGET=
