{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test --test-concurrency=1 --test-timeout=300000 test/*.test.mjs",
    "preview": "vite preview",
    "dev:worker": "vite build && wrangler dev",
    "deploy:staging": "vite build && wrangler deploy --env staging",
    "deploy:production": "vite build && wrangler deploy --env production"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wrangler": "^4.153.0"
  }
}
