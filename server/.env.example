PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/rentease
SESSION_SECRET=replace-with-a-long-random-secret
OTP_SECRET=replace-with-a-different-long-random-secret
# Optional dedicated HMAC key for pickup/return OTPs (32+ random bytes).
# Falls back to OTP_SECRET, then SESSION_SECRET. Rotating it invalidates pending codes.
RENTAL_OTP_SECRET=
# Handover transactions require Atlas or MongoDB configured as a replica set.

# Email verification and booking notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=RentEase <no-reply@example.com>

# Optional SMS booking and delivery notifications (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Geoapify server key for driving routes and optional saved-address geocoding.
# Create at https://myprojects.geoapify.com/ (Free plan, no card required).
# Keep server-only and restrict to your backend's public outbound IP addresses.
# Use a separate browser-restricted VITE_GEOAPIFY_API_KEY in client/.env.
GEOAPIFY_API_KEY=
# Delivery is fixed at LKR 50 per driving kilometer with no base fee.
# Optional existing return-collection rates are managed in Admin > Maps & delivery.

# Payment processing is not connected yet. Add your chosen provider's
# merchant credentials only after a provider account has been created.
PAYMENT_PROVIDER=sandbox
# Private identity verification. Generate two distinct base64-encoded 32-byte keys.
# Keep stable and backed up: rotating the hash key requires a controlled claim migration.
IDENTITY_ENCRYPTION_KEY=
IDENTITY_HASH_KEY=
# Optional; defaults to server/private/identity-v2. Must never be a public/static directory.
IDENTITY_STORAGE_DIR=
# Operational document-retention setting; not a statement of legal compliance.
IDENTITY_RETENTION_DAYS=365
